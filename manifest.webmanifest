{
  "name": "PassFuse",
  "short_name": "PassFuse",
  "description": "Cryptographically secure password generator that runs locally in your browser. Passwords are never stored or sent.",
  "id": ".",
  "start_url": ".",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#090B0F",
  "theme_color": "#090B0F",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "security", "productivity"],
  "shortcuts": [
    {
      "name": "Generate a secure password",
      "short_name": "Generate",
      "description": "Open the PassFuse password generator controls",
      "url": "./#generator-settings",
      "icons": [
        {
          "src": "images/icons/app/icon-192.png",
